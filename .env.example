# Copy this file to .env before starting Docker Compose. Never commit .env.
# Generate production secrets with: openssl rand -hex 32

# Flask. Set FLASK_ENV=development only for explicit local debugging.
FLASK_ENV=production
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters
API_ACCESS_TOKEN=replace-with-a-separate-random-api-access-token
DATABASE_URL=sqlite:///network_scanner.db

# OpenAI is configured server-side only. Do not enter this value in browser settings.
OPENAI_API_KEY=

# Redis is optional outside Docker Compose. Compose builds this URL automatically.
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=replace-with-a-random-redis-password

# Leave empty for the default same-origin frontend/proxy deployment.
# CORS_ORIGINS=https://scanner.example.com

# Optional rate limits. Values use Flask-Limiter syntax.
RATE_LIMIT_DEFAULT=60 per minute
RATE_LIMIT_SCAN=10 per minute
RATE_LIMIT_REPORT=20 per minute
RATE_LIMIT_AI=20 per minute

# Optional PostgreSQL profile for Docker Compose.
POSTGRES_DB=network_scanner
POSTGRES_USER=network_scanner
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
