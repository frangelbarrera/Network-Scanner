# Copy this file to .env before starting Docker Compose. Never commit .env.
# Generate production secrets with: openssl rand -hex 32

# Flask. Set FLASK_ENV=development only for explicit local debugging.
FLASK_ENV=production
SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters
API_ACCESS_TOKEN=replace-with-a-separate-random-api-access-token
# Absolute sqlite paths (four slashes) survive container recreation; the
# Compose deployment stores the database on the backend_data volume.
DATABASE_URL=sqlite:////app/data/network_scanner.db

# OpenAI is configured server-side only. Do not enter this value in browser settings.
OPENAI_API_KEY=
# Optional model override for the AI assistant (default: gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# Redis is optional outside Docker Compose. Compose builds this URL automatically.
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=replace-with-a-random-redis-password

# Leave empty for the default same-origin frontend/proxy deployment.
# CORS_ORIGINS=https://scanner.example.com

# Set to 1 when the backend runs behind a trusted reverse proxy so
# per-client rate limiting honors X-Forwarded-For. Docker Compose sets this.
# TRUST_PROXY=1

# Optional rate limits. Values use Flask-Limiter syntax.
RATE_LIMIT_DEFAULT=60 per minute
RATE_LIMIT_SCAN=10 per minute
RATE_LIMIT_REPORT=20 per minute
RATE_LIMIT_AI=20 per minute

# Optional shared rate-limit storage (requires the redis package). Point it at
# the Compose redis service to share limits across workers, e.g.
# redis://:password@redis:6379/1 — empty keeps per-process memory storage.
RATELIMIT_STORAGE_URI=

# Optional cap on simultaneously running automated scans (default: 2).
# SCAN_CONCURRENCY=2

# Optional server tuning. SOCKETIO_ASYNC_MODE defaults to threading.
# SOCKETIO_ASYNC_MODE=threading
# REPORTS_DIR=/app/reports
# HOST=127.0.0.1

# Optional PostgreSQL profile for Docker Compose.
POSTGRES_DB=network_scanner
POSTGRES_USER=network_scanner
POSTGRES_PASSWORD=replace-with-a-random-postgres-password

# CLI convention: the network-scanner CLI reads this token automatically.
# NETWORK_SCANNER_API_TOKEN=same-value-as-API_ACCESS_TOKEN
